APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_TIMEZONE=Asia/Colombo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


DOCUMENT_DISK=local
DOCUMENT_MAX_SIZE_KB=10240

DOCUMENT_SCANNER_DRIVER=none
DOCUMENT_ALLOW_UNSCANNED_DOWNLOADS=true

DOCUMENT_CLAMAV_BINARY=clamscan
DOCUMENT_SCANNER_TIMEOUT=30


PAYMENT_CURRENCY=LKR
PAYMENT_GATEWAY_DRIVER=sandbox
PAYMENT_SANDBOX_WEBHOOK_SECRET=


NOTIFICATIONS_EMAIL_ENABLED=true

NOTIFICATIONS_SMS_ENABLED=false
NOTIFICATIONS_SMS_DRIVER=null

APPOINTMENT_REMINDER_MINUTES=1440
APPOINTMENT_REMINDER_WINDOW_MINUTES=15


PRIVACY_EXPORT_DISK=local
PRIVACY_EXPORT_DIRECTORY=privacy-exports
PRIVACY_EXPORT_TTL_DAYS=14
